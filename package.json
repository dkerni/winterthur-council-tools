{
  "name": "winterthur-council-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Werkzeuge rund um das Stadtparlament Winterthur (statische Website + Scraper)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "node scripts/scrape-members.mjs",
    "scrape:dry": "node scripts/scrape-members.mjs --dry-run",
    "scrape:agenda": "node scripts/scrape-agenda.mjs",
    "scrape:agenda:dry": "node scripts/scrape-agenda.mjs --dry-run --verbose",
    "scrape:inquiries": "node scripts/scrape-inquiries.mjs",
    "scrape:inquiries:dry": "node scripts/scrape-inquiries.mjs --dry-run --verbose --limit=25",
    "scrape:inquiries:full": "node scripts/scrape-inquiries.mjs --full",
    "scrape:people": "node scripts/scrape-people.mjs",
    "scrape:people:dry": "node scripts/scrape-people.mjs --dry-run --verbose",
    "build:facts": "node scripts/build-inquiry-facts.mjs",
    "build:facts:dry": "node scripts/build-inquiry-facts.mjs --dry-run --verbose",
    "validate": "node scripts/validate-members.mjs",
    "test": "node --test scripts/test/*.test.mjs"
  }
}
